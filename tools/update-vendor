#!/bin/sh
# Re-derive src/vendor/ from the pins in tools/derive-vendor and rewrite
# src/vendor/PROVENANCE to match. Run from the package root after changing
# a pin, then update ZGO_GEOARROW_C_COMMIT in src/zgo.h and the versions
# in tests/testthat/test-info.R, inst/COPYRIGHTS and DESCRIPTION.
#
#   tools/update-vendor
set -eu

tools/derive-vendor src/vendor

COMMIT=$(sed -n 's/^COMMIT=//p' tools/derive-vendor)
VERSION=$(sed -n 's/^VERSION=//p' tools/derive-vendor)
SHA256=$(sed -n 's/^SHA256=//p' tools/derive-vendor)
NANOARROW_TAG=$(sed -n 's/^NANOARROW_TAG=//p' tools/derive-vendor)
NANOARROW_VERSION=$(sed -n 's/^#define NANOARROW_VERSION "\(.*\)"$/\1/p' \
  src/vendor/nanoarrow/nanoarrow.h)

{
  cat <<HEADER
Vendored dependency: geoarrow-c, with the nanoarrow core it ships

  Upstream:      https://github.com/geoarrow/geoarrow-c
  Version:       $VERSION
  Commit:        $COMMIT
  Archive:       https://github.com/geoarrow/geoarrow-c/archive/$COMMIT.tar.gz
  SHA-256:       $SHA256
  nanoarrow:     $NANOARROW_VERSION ($NANOARROW_TAG), its core bundled by
                 upstream's ci/scripts/bundle.py with
                 --symbol-namespace=ZugeoNanoarrow; the release archive is
                 checked by Apache's published SHA-512
  License:       Apache-2.0 (geoarrow-c, nanoarrow)
  Local patches: applied in this order, from tools/patches/
$(for p in tools/patches/*.patch; do [ -f "$p" ] && printf '                 %s\n' "$(basename "$p")"; done)

src/vendor/geoarrow/geoarrow.h and geoarrow.c are the output of
upstream's CMake bundler (GEOARROW_BUNDLE=ON) with
GEOARROW_NAMESPACE=Zugeo, GEOARROW_USE_FAST_FLOAT=OFF (fast_float is
C++) and GEOARROW_USE_RYU=OFF (ryu's assert() calls; design Q11 decides
how numbers are printed); the C++ geoarrow.hpp is left out.
tools/derive-vendor is the derivation; tools/verify-vendor re-runs it
and fails on any difference.

Patches:
  0001-zufast-numbers.patch  prints numbers in geoarrow.c through
      zufast's shortest round-trip formatter at the default precision and
      parses them with zufast's correctly rounded parser instead of
      strtod(), so WKT round-trips exactly on every platform (zugeo design
      D18, Q11). A value outside the double range becomes a parse error.
  0002-wkb-reader-bounds.patch  makes the WKB reader take a coordinate
      sequence's bytes off size_bytes as well as data, and compute their
      size in 64 bits. Upstream advanced only data, so after one
      coordinate sequence every bounds check counted bytes already read,
      and a truncated buffer was read past its end (found by Stage 3's
      truncation test). To be offered upstream.

SHA-256 of every vendored file:
HEADER
  (cd src/vendor && find . -type f ! -name '*.o' ! -name PROVENANCE |
    LC_ALL=C sort | while read -r f; do
      printf '  %s  %s\n' "$(shasum -a 256 "$f" | cut -d' ' -f1)" "${f#./}"
    done)
} > src/vendor/PROVENANCE
echo "==> src/vendor/ re-derived; PROVENANCE rewritten"
