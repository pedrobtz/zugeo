#!/bin/sh
# Derive the vendored tree from the pinned geoarrow-c commit: download the
# commit's archive, check its SHA-256, run upstream's own CMake bundler with
# the zugeo symbol namespace, and keep the C files. Writes the tree to the
# directory given as $1. Shared by tools/update-vendor and
# tools/verify-vendor. Run from the package root.
#
#   tools/derive-vendor <out-dir>
#
# The tree holds two libraries (design section 7):
#   geoarrow/   geoarrow-c's C bundle (geoarrow.h, geoarrow.c), no C++
#   nanoarrow/  the nanoarrow core, release 0.9.0, through upstream's own
#               bundler, with nanoarrow's LICENSE.txt and NOTICE.txt
set -eu

OUT=$1

# geoarrow-c has no release after v0.1.2; the design pins a commit (§7).
COMMIT=b3db89fec68043ade505fffb62a668043812884a
VERSION=0.2.0-SNAPSHOT
URL="https://github.com/geoarrow/geoarrow-c/archive/$COMMIT.tar.gz"
SHA256=d755e1ec9aa8828d496fe26e918378e63b566b19f540aea19adee9737bdd3a64

# nanoarrow 0.9.0, the release zuarrow vendors, rather than the 0.8.0
# geoarrow-c pins: GCC 16 reports a null destination for snprintf() in
# 0.8.0's ArrowSchemaToString(), which 0.9.0 rewrote (design section 7).
# The SHA-512 is the digest Apache publishes beside the release.
NANOARROW_TAG=apache-arrow-nanoarrow-0.9.0
NANOARROW_URL="https://github.com/apache/arrow-nanoarrow/releases/download/$NANOARROW_TAG/$NANOARROW_TAG.tar.gz"
NANOARROW_SHA512=2fbdfe3274da9dcba5e3215ba0a7ff66da9f65395d1800841f0dc9a6bbc00b8cc224f900bcb946c91969b3c6e79d132ad5077c9a537f861502c4763dbffb33b8

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

fetch() { # fetch <url> <file> <sha> [<algorithm>]
  curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused -o "$2" "$1"
  actual=$(shasum -a "${4:-256}" "$2" | cut -d' ' -f1)
  if [ "$actual" != "$3" ]; then
    echo "FAIL: $1 sha${4:-256} mismatch" >&2
    echo "  expected $3" >&2
    echo "  actual   $actual" >&2
    exit 1
  fi
}

fetch "$URL" "$WORK/src.tar.gz" "$SHA256"
tar xzf "$WORK/src.tar.gz" -C "$WORK"
SRC="$WORK/geoarrow-c-$COMMIT"

# Upstream's bundler. fast_float is C++, so it stays off and parsing uses
# strtod(), which R keeps in the C numeric locale. ryu stays off too: its
# assert() calls reach the shared object in builds that ignore NDEBUG, and
# the WKT writer prints with snprintf() until design Q11 decides how
# numbers are printed exactly.
cmake -S "$SRC" -B "$WORK/build" \
  -DGEOARROW_BUNDLE=ON -DGEOARROW_NAMESPACE=Zugeo \
  -DGEOARROW_USE_FAST_FLOAT=OFF -DGEOARROW_USE_RYU=OFF > /dev/null
cmake --install "$WORK/build" --prefix "$WORK/bundle" > /dev/null

TREE="$WORK/tree"
mkdir -p "$TREE/geoarrow" "$TREE/nanoarrow"
# C only: geoarrow.hpp stays out of zugeo.so.
cp "$WORK/bundle/geoarrow.h" "$WORK/bundle/geoarrow.c" "$TREE/geoarrow/"
cp "$SRC/LICENSE" "$TREE/geoarrow/LICENSE"

fetch "$NANOARROW_URL" "$WORK/nanoarrow.tar.gz" "$NANOARROW_SHA512" 512
tar xzf "$WORK/nanoarrow.tar.gz" -C "$WORK"
NSRC="$WORK/$NANOARROW_TAG"
# Upstream's bundler, as zuarrow and nanoarrow's own R package use it. -I
# keeps Python from importing anything from the extracted tree.
(cd "$NSRC" && python3 -I ci/scripts/bundle.py \
  --symbol-namespace=ZugeoNanoarrow --header-namespace= \
  --include-output-dir="$WORK/nbundle" --source-output-dir="$WORK/nbundle" > /dev/null)
cp "$WORK/nbundle/nanoarrow.c" "$WORK/nbundle/nanoarrow.h" "$TREE/nanoarrow/"
cp "$NSRC/LICENSE.txt" "$NSRC/NOTICE.txt" "$TREE/nanoarrow/"

rm -rf "$OUT"
mkdir -p "$(dirname "$OUT")"
cp -R "$TREE" "$OUT"
